# Django Core Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://yourdomain.com

# Database Configuration (PostgreSQL on Render)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Email Configurations (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@domain.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Hive <noreply@yourdomain.com>

# Background Task Queue (Celery & Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cloudinary / External Media Storage (Optional)
CLOUDINARY_URL=
